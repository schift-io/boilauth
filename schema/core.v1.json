      "userId": {
        "type": "string",
        "required": true
      }
    },
    "user": {
      "createdAt": {
        "type": "date",
        "required": true
      },
      "email": {
        "type": "string",
        "required": true
      },
      "emailVerified": {
        "type": "boolean",
        "required": true
      },
      "failedLoginCount": {
        "type": "number",
        "required": false
      },
      "image": {
        "type": "string",
        "required": false
      },
      "lockedUntil": {
        "type": "date",
        "required": false
      },
      "name": {
        "type": "string",
        "required": true
      },
      "updatedAt": {
        "type": "date",
        "required": true
      }
    },
    "verification": {
      "createdAt": {
        "type": "date",
        "required": true
      },
      "expiresAt": {
        "type": "date",
        "required": true
      },
      "identifier": {
        "type": "string",
        "required": true
      },
      "updatedAt": {
        "type": "date",
        "required": true
      },
      "value": {
        "type": "string",
        "required": true
      }
    }
  }
}
