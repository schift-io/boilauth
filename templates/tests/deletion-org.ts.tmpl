  const noAdmin = await del();
  assert.equal(noAdmin.status, 409, "no admin to take over");
  assert.equal(noAdmin.json.code, "ORG_OWNER_TRANSFER_REQUIRED");
  assert.equal(await roleOf(owner.email), "owner", "nothing changed");
  const admin = await join("admin");
{{LAST_OWNER_BRANCH}}  assert.equal(await roleOf(owner.email), undefined, "the deleted user left the organization");
  assert.equal(await roleOf(member.email), "member");
});
