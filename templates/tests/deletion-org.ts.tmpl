  };
  const member = await join("member");
  const members = async () =>
    (await h.call(auth, `/organization/list-members?organizationId=${organizationId}`, { jar: member.jar })).json.members as any[];
  const roleOf = async (email: string) => (await members()).find((m) => m.user.email === email)?.role;
