test("migration from firebase: import, sign in with the original password, hash upgraded to argon2id", { skip: h.SKIP }, async () => {
  const auth = await h.makeAuth();
  const report = await boil.importUsers(auth, "firebase", boil.parseFirebaseExport(h.fixture("firebase-users.json"), h.FIREBASE_SAMPLE_KEY));
  assert.ok(report.created >= 1, JSON.stringify(report));
  const ctx = await auth.$context;
  const hash = async () => {
    const u = await ctx.internalAdapter.findUserByEmail("user1@test.com");
    return (await ctx.internalAdapter.findCredentialAccount(u!.user.id))!.password as string;
  };
  assert.ok(!(await hash()).startsWith("$argon2id$"));
  const wrong = await h.call(auth, "/sign-in/email", { body: { email: "user1@test.com", password: "not-the-password" } });
  assert.equal(wrong.status, 401);
  await h.signIn(auth, "user1@test.com", "user1password");
  assert.ok((await hash()).startsWith("$argon2id$"), "hash upgraded after the first login");
  await h.signIn(auth, "user1@test.com", "user1password");
});
