/**
 * How this project's requests carry the client IP (network.clientIp): the socket address, a
 * trusted proxy forwarding it in X-Forwarded-For, or a platform header.
 */
const IP_MODE = {{IP_MODE}} as { mode: "socket" } | { mode: "proxy"; proxy: string } | { mode: "header"; header: string };
export function ipOf(headers: Record<string, string>, ip: string): { clientIp: string } | undefined {
  if (IP_MODE.mode === "header") {
    headers[IP_MODE.header] = ip;
    return undefined;
  }
  if (IP_MODE.mode === "proxy") {
    headers["x-forwarded-for"] = ip;
    return { clientIp: IP_MODE.proxy };
  }
  return { clientIp: ip };
}

let ipN = 0;
/** Test client IPs from 198.18.0.0/15 (RFC 2544 benchmarking): never one of your proxies. */
export function nextIp(): string {
  ipN++;
  return `198.${18 + ((ipN >> 16) & 1)}.${(ipN >> 8) & 255}.${ipN & 255}`;
}

let userN = 0;
