test("migration from auth0: import, sign in with the original password, hash upgraded to argon2id", { skip: h.SKIP }, async () => {
  const auth = await h.makeAuth();
  const report = await boil.importUsers(auth, "auth0", boil.parseAuth0Export(h.fixture("auth0-users.ndjson")));
  assert.ok(report.created >= 1, JSON.stringify(report));
  const ctx = await auth.$context;
  const hash = async () => {
    const u = await ctx.internalAdapter.findUserByEmail("linus@example.com");
    return (await ctx.internalAdapter.findCredentialAccount(u!.user.id))!.password as string;
  };
  assert.ok(!(await hash()).startsWith("$argon2id$"));
  const wrong = await h.call(auth, "/sign-in/email", { body: { email: "linus@example.com", password: "not-the-password" } });
  assert.equal(wrong.status, 401);
  await h.signIn(auth, "linus@example.com", "Kk4DQuMMfZL9o");
  assert.ok((await hash()).startsWith("$argon2id$"), "hash upgraded after the first login");
  await h.signIn(auth, "linus@example.com", "Kk4DQuMMfZL9o");
});
