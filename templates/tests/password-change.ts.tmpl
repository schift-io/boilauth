test("password change {{REVOKE_LABEL}} the user's other sessions", { skip: h.SKIP }, async () => {
  const auth = await h.makeAuth();
  const { email, jar: other } = await h.newUser(auth, "pwc");
  const current = await h.signIn(auth, email);
  const r = await h.call(auth, "/change-password", { body: { currentPassword: h.PW, newPassword: "new-password-4242" }, jar: current });
  assert.equal(r.status, 200, JSON.stringify(r.json));
  assert.equal(Boolean(await h.currentSession(auth, other)), {{OTHER_ALIVE}});
  assert.ok(await h.currentSession(auth, current), "the session that changed the password stays");
  await h.signIn(auth, email, "new-password-4242");
});
