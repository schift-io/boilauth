export const VERIFICATION_REQUIRED = {{VERIFICATION_REQUIRED}};

/** A new user with a password (verified when verification is required), signed in. */
export async function newUser(auth: Auth, tag = "u"): Promise<{ email: string; jar: Jar }> {
  const email = newEmail(tag);
  const r = await call(auth, "/sign-up/email", { body: { email, password: PW, name: "Test User" } });
  if (r.status !== 200) throw new Error(`sign-up ${r.status} ${JSON.stringify(r.json)}`);
  if (VERIFICATION_REQUIRED) await call(auth, lastMail(email, "/verify-email"));
  return { email, jar: await signIn(auth, email) };
}

export async function signIn(auth: Auth, email: string, password = PW): Promise<Jar> {
  const jar: Jar = new Map();
  const r = await call(auth, "/sign-in/email", { body: { email, password }, jar });
  if (r.status !== 200) throw new Error(`sign-in ${r.status} ${JSON.stringify(r.json)}`);
  return jar;
}
